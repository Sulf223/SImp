{
    "name": "simp/portal",
    "description": "SImp Portal — platformă educațională pentru algoritmi",
    "type": "project",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "SImp\\": "site_g/PHP/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SImp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "stan": "phpstan analyse site_g/PHP --level 4"
    }
}
