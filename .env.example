# ============================================================================
# SImp Portal — Environment Configuration Template
# ============================================================================
# Copy this file to `.env` and fill in your values
# IMPORTANT: Never commit `.env` with real credentials to git!
# ============================================================================

# 🤖 AI/Profesor Configuration (Optional)
# Get your Groq API key at: https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here_replace_me
GROQ_MODEL=llama-3.3-70b-versatile

# 🗄️ Database Configuration (Docker)
# These match docker-compose.yml services
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASS=root123
DB_NAME=dbsortari

# 🏗️ Application Environment
# Options: development, staging, production
APP_ENV=development
APP_DEBUG=false

# 🔐 Security (for production only)
# Generate with: openssl rand -base64 32
APP_KEY=

# 📊 Monitoring (Optional)
SENTRY_DSN=
LOG_LEVEL=error

# 📧 Email (Optional, for notifications)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@simp-portal.local

# 🌐 Server
SITE_URL=http://localhost:8082
ADMIN_EMAIL=admin@simp-portal.local

# 🐳 Docker Specific
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ============================================================================
# PRODUCTION SECURITY REMINDER:
# ============================================================================
# ⚠️  BEFORE DEPLOYING TO PRODUCTION:
#   1. Change all default credentials (DB_PASS, etc.)
#   2. Use strong, randomly-generated passwords
#   3. Set APP_DEBUG=false
#   4. Set APP_ENV=production
#   5. Configure proper logging
#   6. Enable HTTPS in reverse proxy
#   7. Use environment-specific .env files
#   8. Never commit .env to version control
#   9. Use Docker Secrets or Vault for credential management
#  10. Rotate API keys regularly
# ============================================================================
