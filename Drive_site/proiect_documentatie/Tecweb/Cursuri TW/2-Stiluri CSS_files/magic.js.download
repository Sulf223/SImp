$(document).ready(function() {
    setTimeout(function() {
        setActiveStyleSheet('blue')
    }, 2000);
    // $("body > #container").addClass('boxed-page');
    $(".slicknav_nav").html($(".navbar-nav").html());
})
var cuprins = function() {
    if ($(document).scrollTop() > 100 && $(document).width() > 992)
        $(".widget-categories").addClass('special-sidebar');
    else
        $(".widget-categories").removeClass('special-sidebar');
}
